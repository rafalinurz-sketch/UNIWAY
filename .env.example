# Anthropic API — для AI-оценки IELTS (lib/ielts-grading.ts)
ANTHROPIC_API_KEY=sk-ant-...

# База данных (Supabase Postgres или любой Postgres-провайдер)
DATABASE_URL=postgresql://user:password@host:5432/uniway

# Supabase (если используете Auth/Storage для аудио Speaking-ответов)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...
